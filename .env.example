# Supabase self-hosted API URL and public anon key.
# Leave both unset to disable cloud sync UI.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push VAPID public key (generate with: npx web-push generate-vapid-keys --json).
# Pair with VAPID_PRIVATE_KEY on the server for scripts/send-push-reminders.mjs.
# VITE_VAPID_PUBLIC_KEY=

# Optional client telemetry endpoint (POST JSON error/warning events).
# VITE_TELEMETRY_URL=https://example.com/telemetry

# Google Analytics 4 measurement ID (production only).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only OpenAI key for Plan My Food → Generate meal ideas (Vite middleware).
# Never prefix with VITE_ — the client must not receive this value.
# OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini). Prefer mini/nano, not flagship.
# OPENAI_MEAL_MODEL=gpt-4o-mini
